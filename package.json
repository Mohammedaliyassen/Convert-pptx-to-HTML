{
  "name": "story-engine-player",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/story-player.umd.js",
  "module": "./dist/story-player.es.js",
  "types": "./dist/story-player.d.ts",
  "exports": {
    ".": {
      "import": "./dist/story-player.es.js",
      "require": "./dist/story-player.umd.js",
