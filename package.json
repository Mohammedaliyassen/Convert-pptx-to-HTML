    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
